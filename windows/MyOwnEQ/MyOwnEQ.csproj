<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>MyOwnEQ</RootNamespace>
    <AssemblyName>MyOwnEQ</AssemblyName>
    <ApplicationIcon>Assets\MyOwnEQ.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Fluent ThemeMode is flagged experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same logo as the Mac app (windows/scripts/make-icon.sh). Window + tray icon. -->
    <Resource Include="Assets\MyOwnEQ.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Themes and languages shared with the Mac app (single source: repo themes/ and lang/). -->
    <None Include="../../themes/*.json" Link="Themes\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../lang/*.json" Link="Lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Rust core, built by windows/build.ps1 or CI into ../../target/release -->
  <ItemGroup Condition="Exists('../../target/release/myowneq_ffi.dll')">
    <None Include="../../target/release/myowneq_ffi.dll" Link="myowneq_ffi.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
